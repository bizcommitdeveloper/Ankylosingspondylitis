# Expo public configuration. Copy this file to `.env.local` and fill in the
# values. Anything prefixed EXPO_PUBLIC_ is embedded in the app bundle at build
# time — these Firebase values are public project identifiers (not secrets);
# access is controlled by Firestore security rules, not by hiding them.

# Firebase Web SDK config — Firebase console → Project settings → Your apps.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (optional). Create OAuth client IDs in Google Cloud console
# (or Firebase Auth → Google provider). If left blank, the app shows
# email/password sign-in only. The "web" client ID is used to obtain the
# Google ID token that is exchanged for a Firebase credential.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
